   /* DESMOS EMBED (interactive supplement to a diagram, not a replacement) */
   .desmos-embed{background:var(--bg-soft);border:1px solid var(--border);border-radius:var(--radius);
-    padding:16px;margin:28px auto;max-width:640px;}
-  .desmos-embed iframe{width:100%;min-height:420px;border:0;border-radius:6px;display:block;}
+    padding:16px;margin:28px auto;max-width:720px;}
+  .desmos-embed iframe{width:100%;min-height:460px;border:0;border-radius:6px;display:block;}
   .desmos-embed figcaption{margin-top:10px;font-size:0.78rem;color:var(--muted);text-align:center;}
   .desmos-embed .demo-label{display:block;font-weight:700;font-size:0.78rem;color:var(--rust-deep);
     text-transform:uppercase;letter-spacing:0.08em;margin-bottom:10px;text-align:center;}
+  /* .wrap's own content box (viewport minus its 48px padding) must itself be >=900px before a
+     900px breakout can fit without overflowing past .wrap's edges — that needs viewport >= 948px,
+     not just wherever .prose happens to hit its 720px cap (768px), which is a separate constraint. */
+  @media (min-width:970px){
+    .desmos-embed{max-width:900px;margin-left:-90px;margin-right:-90px;}
+  }
 
   /* WORKED ALGEBRA DEMO (mirrors the ldmexample terracotta convention from the LaTeX notes system) */
